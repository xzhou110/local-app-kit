{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "newLine": "lf"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test-support.ts"]
}
